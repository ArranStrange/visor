# Client environment variables.
#
# Copy to .env (or .env.local) and adjust. Only variables prefixed with VITE_
# are exposed to the browser bundle — never put a secret in this file or in
# any VITE_ variable, because everything here ships to the client.
#
# Read through src/config/environment.ts, which is the single place these are
# consumed.

# --- API -------------------------------------------------------------------

# GraphQL endpoint. Required in production; in development it falls back to
# http://localhost:4000/graphql.
VITE_GRAPHQL_URI=http://localhost:4000/graphql

# Endpoint used when the dev server is opened from another device on the LAN
# (phone testing). Falls back to http://<hostname>:4000/graphql.
# VITE_GRAPHQL_MOBILE_URI=http://192.168.1.10:4000/graphql

# --- Feature flags ---------------------------------------------------------

# Require email verification before an account can be used. Default: on.
# VITE_ENABLE_EMAIL_VERIFICATION=false

# Narrow film sim listings to the sensor generation of the user's primary
# camera. Default: on. Set to false to serve unfiltered listings.
# VITE_ENABLE_CAMERA_FILTER=false

# --- Media -----------------------------------------------------------------

# Cloudinary cloud name used to build optimised image URLs.
VITE_CLOUDINARY_CLOUD_NAME=
