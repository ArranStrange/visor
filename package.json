{
  "name": "visor",
  "version": "1.0.0",
  "private": true,
  "description": "VISOR – Curate, Share, and Discover Creative Looks",
  "license": "MIT",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "seed": "npm run seed --workspace server",
    "lint": "npm run lint --workspace client",
    "format": "npm run format --workspace client",
    "deploy:client": "npm run deploy --workspace client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18"
  }
}
